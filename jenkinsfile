pipeline {
  agent any

  environment {
    DOCKER_USER = credentials('docker-username')
    DOCKER_PASS = credentials('docker-password')
  }

  stages {

    stage('Build Images') {
      steps {
        sh 'docker build -t $DOCKER_USER/hello-backend backend'
        sh 'docker build -t $DOCKER_USER/hello-frontend frontend'
      }
    }

    stage('Push Images') {
      steps {
        sh '''
        echo $DOCKER_PASS | docker login -u $DOCKER_USER --password-stdin
        docker push $DOCKER_USER/hello-backend
        docker push $DOCKER_USER/hello-frontend
        '''
      }
    }

    stage('Deploy to Kubernetes') {
      steps {
        sh 'kubectl apply -f k8s/'
      }
    }
  }
}
